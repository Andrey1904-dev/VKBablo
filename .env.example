# VK AI Manager — пример переменных окружения
#
# Как пользоваться:
#   cp .env.example .env      — для локального стенда разработки (npm run dev)
#   supabase secrets set ...   — для серверных секретов Edge Functions (см. CODEX_SETUP.md)
#
# ПРАВИЛА БЕЗОПАСНОСТИ
#   • Реальные секреты в Git не попадают: .env в .gitignore.
#   • Ключи и пароли НЕ присылайте в чат и не вставляйте в issues.
#   • service_role, VK-токены и AI-ключи живут только на сервере:
#     в браузер попадают лишь публичные значения (URL + anon/publishable key).
#   • Всё, что начинается с VITE_, видно в собранном JavaScript. Секретов там быть не должно.

# ---------------------------------------------------------------------------
# 1. Локальный стенд разработки (Node API, server/)
# ---------------------------------------------------------------------------
PORT=8787
NODE_ENV=development

# Ключ подписи сессий и ключ шифрования секретов локального стенда.
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-passphrase

# Локальный Node/SQLite backend принудительно работает только в test/dry-run.
# Не задавайте APP_MODE=approval в локальном .env: real VK доступен только через защищённый Supabase worker.

# Разрешённые origin для локального API (через запятую)
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Лимит расходов AI в месяц, USD. 0 или некорректное значение блокирует платные вызовы (не означает «без лимита»).
# Платные вызовы дополнительно требуют явного ai_paid_calls_enabled=true, режима approval,
# серверного ключа и атомарного резерва бюджета. Локальный backend остаётся dry-run.
AI_MONTHLY_LIMIT_USD=20
# AI_PAID_CALLS_ENABLED=false  # только legacy SQLite setting; локальный режим принудительно test

# ---------------------------------------------------------------------------
# 2. Публичные переменные фронтенда (попадают в бандл — секретов не бывает)
# ---------------------------------------------------------------------------
# URL проекта Supabase и публичный (publishable/anon) ключ. Безопасны при включённом RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Режим слоя данных: auto | supabase | local | demo
#   auto (по умолчанию) — Supabase при заданных публичных ключах, иначе автономный демо-режим;
#   demo — демонстрационные данные в браузере, публикация в VK технически невозможна.
VITE_BACKEND_MODE=auto

# Адрес локального API для VITE_BACKEND_MODE=local (пусто = относительные пути /api)
VITE_LOCAL_API_BASE=

# Роутинг: true (по умолчанию) — hash-роутинг, нужен для GitHub Pages без сервера перезаписи URL.
VITE_USE_HASH_ROUTER=true

# Базовый путь сборки для GitHub Pages (например /VKBablo/); задаётся в workflow.
VITE_BASE=/

# ---------------------------------------------------------------------------
# 3. Серверные секреты Supabase (Edge Functions: vk-ai-api, vk-ai-worker)
#    Задаются через `supabase secrets set` или Dashboard → Edge Functions → Secrets.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # только сервер, никогда в браузер
# ENCRYPTION_KEY=                       # AES-256-GCM для VK-токенов и AI-ключа в БД
# WORKER_SECRET=                        # значение заголовка x-worker-secret для Cron
# Cron Vault values are configured separately in Supabase Vault, never in frontend env:
#   vk_ai_worker_url, vk_ai_worker_secret
# Owner API settings/test-worker sends task=health with this secret server-side.
# The current UI has no worker-health button.
# Health leaves queues untouched (queueTouched=false), but attempts a best-effort worker_run audit insert.
# cron.job/job_run_details show schedule/SQL invocation only; correlate cron_dispatch requestId,
# net._http_response (if retained), and worker_run source=pg_cron to verify HTTP/worker execution.
# OWNER_SETUP_SECRET=                   # 32–256 символов; только Edge Function secret, никогда VITE_*
# APP_ORIGINS=https://andrey1904-dev.github.io,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 4. Внешние API (подключаются владельцем позже, сейчас пусто)
# ---------------------------------------------------------------------------
# AI_API_KEY=                            # включает реальный провайдер вместо тестового движка
# AI_BASE_URL=https://api.openai.com/v1
# AI_TEXT_MODEL=gpt-4o-mini
# AI_IMAGE_MODEL=dall-e-3
# VK_API_VERSION=5.199                   # токен сообщества хранится в БД в зашифрованном виде,
#                                        # в переменных окружения его быть не должно

# ---------------------------------------------------------------------------
# 5. Первичный владелец (разные механизмы для local и Supabase)
# ---------------------------------------------------------------------------
# Local Node server only: one-time bootstrap on first startup. Keep these only
# in the ignored local .env; remove them after the owner is created.
# BOOTSTRAP_EMAIL=owner@example.com
# BOOTSTRAP_PASSWORD=                    # не храните пароль в Git/командной строке
#
# Supabase operator CLI: run `node scripts/bootstrap-owner.mjs` in an
# interactive terminal after migrations + Edge Function deployment. The script
# prompts for owner password and OWNER_SETUP_SECRET without echo. Optional
# operator variables (not VITE_ and not required):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_PASSWORD=                        # лучше не задавать; CLI спросит скрыто
# OWNER_SETUP_SECRET=                    # лучше не задавать; CLI спросит скрыто
