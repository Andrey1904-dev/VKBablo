# VK AI Manager — environment
# Copy to .env and fill in. Never commit real secrets.

PORT=8787
NODE_ENV=development

# Session and encryption (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-passphrase

# First-run owner is created in the UI. Optional bootstrap:
# BOOTSTRAP_EMAIL=owner@example.com
# BOOTSTRAP_PASSWORD=use-a-strong-password

# Operating mode: test | approval
# test      — generate content, simulate VK, never publish for real
# approval  — generate content, publish to VK only after manual approval
APP_MODE=test

# Public URL of the app (used for Origin checks in production)
APP_URL=http://localhost:5173

# Expense cap for AI (USD, 0 = unlimited)
AI_MONTHLY_LIMIT_USD=20
