# VK AI Manager — environment
# Copy to .env and fill in. Never commit real secrets.
# Do not paste keys into chat.

PORT=8787
NODE_ENV=development

# Session and encryption (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-passphrase

# First-run owner is created in the UI. Optional bootstrap:
# BOOTSTRAP_EMAIL=owner@example.com
# BOOTSTRAP_PASSWORD=use-a-strong-password

# Operating mode: test | approval
# test      — generate content, simulate VK, never publish for real (dry-run)
# approval  — generate content, publish to VK only after manual approval
APP_MODE=test

# Public URL of the app (used for Origin checks in production)
APP_URL=http://localhost:5173

# Expense cap for AI (USD, 0 = unlimited)
AI_MONTHLY_LIMIT_USD=20

# --- Supabase (production data, auth, storage, realtime) ---
# Server only. Never expose SERVICE_ROLE to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend public keys (anon is safe with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI (OpenAI-compatible). Leave empty to use the built-in test engine.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TEXT_MODEL=gpt-4o-mini
# AI_IMAGE_MODEL=dall-e-3
